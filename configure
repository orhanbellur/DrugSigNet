#!/bin/sh

# Package installation must not mutate the user's external runtime. In
# particular, configure may run while pak is creating a source package, where
# creating a conda environment is both surprising and unreliable. Python is
# provisioned explicitly after installation with setup_python_dependencies(),
# or as part of the fully rootless Micromamba installer.
set -eu

echo "DrugSigNet: external Python setup is deferred until after installation"
